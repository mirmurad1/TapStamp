# nginx başlanğıcda bu şablondan /etc/nginx/conf.d/app.conf yaradır (envsubst).
# ${...} şəklində yalnız env dəyişənləri əvəz olunur; nginx-in öz $dəyişənlərinə toxunulmur.

upstream backend {
    # Hansı konteyner(lər)ə göndəriləcəyi: deploy skripti bu faylı dəyişir (scripts/deploy.sh)
    include /etc/nginx/upstreams/backend.conf;
    keepalive 16;
}

upstream frontend {
    include /etc/nginx/upstreams/frontend.conf;
    keepalive 16;
}

# Platforma domenində yalnız admin paneli var: müştəri tətbiqinin səhifələri /admin-ə yönləndirilir, onun servis
# işçisi (sw.js) 404 qaytarır — əvvəllər quraşdırılmış servis işçisi brauzerdə özü silinir. Sıra vacibdir.
map "$host$uri" $platform_customer_path {
    default "";
    "~^${APP_PLATFORM_DOMAIN}/sw\.js$" "gone";
    "~^${APP_PLATFORM_DOMAIN}/(?!admin(/|$)|assets/|favicon\.svg$)" "admin";
}

# Link önizləmə botları (WhatsApp, Telegram, Viber, Facebook/Instagram, X, Slack, Discord, LinkedIn, VK və s.):
# JavaScript işlətmir, ona görə /menu üçün backend-in Open Graph HTML-i verilir (catalog/web/MenuShareController)
# Sıra vacibdir (ilk uyğun gələn qalib gəlir): əvvəl brauzer mühərrikli axtarış botları, sonra bütün real brauzerlər
# (tətbiq daxili brauzerlər də: Viber, Yandex Browser, Pinterest, Facebook) — onlar bot deyil, adi tətbiqi almalıdır.
# Əvvəllər "viber", "yandex", "pinterest" sözləri Viber-in QR skanerindən açılan brauzeri, Yandex Browser-i və s.
# bot sayırdı: müştəri menyu əvəzinə önizləmə səhifəsində qalırdı (ağ ekran).
map $http_user_agent $link_preview_bot {
    default 0;
    "~*(googlebot|bingbot|applebot|yandexbot|yandeximages)" 1;
    "~*(applewebkit|gecko/)" 0;
    "~*(whatsapp|telegrambot|viber|facebookexternalhit|facebot|meta-externalagent|twitterbot|slackbot|discordbot|linkedinbot|skypeuripreview|vkshare|pinterest)" 1;
}

# HTTP: yalnız ACME (Let's Encrypt) yoxlaması və HTTPS-ə yönləndirmə
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# SNI göndərməyən və ya tanınmayan domenlə gələn TLS bağlantıları rədd edilir
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# Şirkət saytı (trendsolutions.az): statik fayllar nginx-dən verilir, backend-də yalnız demo müraciəti forması var.
# www. ünvanı əsas domenə yönləndirilir. Dəqiq server_name aşağıdakı regex blokundan əvvəl seçilir.
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_SITE_DOMAIN} www.${APP_SITE_DOMAIN};

    include /etc/nginx/snippets/tls.conf;

    if ($host = www.${APP_SITE_DOMAIN}) {
        return 301 https://${APP_SITE_DOMAIN}$request_uri;
    }

    root /usr/share/nginx/site;

    # Demo müraciəti: kiçik JSON, IP üzrə sıx limit (backend də IP və gündəlik limit tətbiq edir)
    location = /api/v1/site/demo-requests {
        client_max_body_size 8k;
        limit_req zone=site_form_per_ip burst=3 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }
    location / {
        try_files $uri $uri/ =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${NGINX_HSTS_HEADER}" always;
        add_header Cache-Control "no-cache" always;
    }
    # CSS və JS: fayl adları versiyasızdır — brauzer hər dəfə yoxlayır (dəyişməyibsə 304, ucuzdur), yoxsa yeni HTML
    # köhnə JS ilə birləşir (məs. yeni mətn açarları "undefined" görünür)
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${NGINX_HSTS_HEADER}" always;
        add_header Cache-Control "no-cache" always;
    }
    # Şriftlər dəyişmir: 30 gün
    location /assets/fonts/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${NGINX_HSTS_HEADER}" always;
        add_header Cache-Control "public, max-age=2592000" always;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # Yalnız düzgün formatlı domen adları (sertifikat faylının yolunda istifadə olunur)
    server_name ~^[a-z0-9-]+(\.[a-z0-9-]+)+$;

    include /etc/nginx/snippets/tls.conf;

    location /api/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Şirkət loqosunun yüklənməsi: ümumi 64k limitindən istisna (fayl 1 MB-a qədər, backend də yoxlayır)
    location = /api/v1/admin/settings/company/logo {
        client_max_body_size 2m;
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Kataloq (menyu) şəkillərinin yüklənməsi: fayl 2 MB-a qədər (backend də yoxlayır)
    location ~ ^/api/v1/admin/catalog/items/[0-9a-f-]+/image$ {
        client_max_body_size 3m;
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Menyu şəkilləri: menyu açılanda bir anda onlarla şəkil istənir. Ümumi limit (burst 40) bəzilərini 429 ilə kəsə
    # bilərdi; ünvanlar versiyalıdır və brauzerdə 1 il keşlənir, ona görə daha geniş burst təhlükəsizdir
    location ~ ^/api/v1/public/catalog/items/[0-9a-f-]+/(image|thumb)$ {
        limit_req zone=api_per_ip burst=200 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # NFC toxunuşu: kriptoqrafik yoxlama backend-dədir
    location /t/ {
        limit_req zone=tap_per_ip burst=10 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Actuator-dan yalnız health xaricə açıqdır
    location ~ ^/actuator/health(/(liveness|readiness))?$ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }
    location /actuator {
        return 404;
    }

    # Daxili endpoint-lər (məs. TLS domen siyahısı) heç vaxt xaricə açılmır
    location /internal {
        return 404;
    }

    # Swagger UI yalnız dev profilində mövcuddur; prod-da backend 404 qaytarır
    location /swagger-ui/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Menyu linki: botlara önizləmə HTML-i (sorğu parametrləri saxlanılır), insanlara adi tətbiq
    location = /menu {
        if ($link_preview_bot) {
            rewrite ^ /api/v1/public/share/menu last;
        }
        if ($platform_customer_path = "admin") {
            return 302 /admin;
        }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${NGINX_HSTS_HEADER}" always;
        proxy_pass http://frontend;
        proxy_next_upstream error timeout http_502;
        proxy_next_upstream_tries 2;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }

    location / {
        if ($platform_customer_path = "gone") {
            return 404;
        }
        if ($platform_customer_path = "admin") {
            return 302 /admin;
        }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${NGINX_HSTS_HEADER}" always;
        proxy_pass http://frontend;
        proxy_next_upstream error timeout http_502;
        proxy_next_upstream_tries 2;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "fe-tapstamp",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "frontend-dev-docker-backend",

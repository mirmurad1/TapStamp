# TapStamp — konfiqurasiya nümunəsi.
# .env faylını əl ilə doldurmayın: scripts/gen-secrets.ps1 (Windows) və ya scripts/gen-secrets.sh
# bu faylı kopyalayıb boş sirləri kriptoqrafik təsadüfi dəyərlərlə doldurur.
# .env faylı heç vaxt git-ə əlavə olunmur.

# --- Ümumi ---
SPRING_PROFILES_ACTIVE=dev
HTTPS_PORT=443
HTTP_PORT=80
APP_PLATFORM_DOMAIN=platform.localhost
# Prod-da: max-age=63072000; includeSubDomains
NGINX_HSTS_HEADER=

# --- PostgreSQL (sirlər) ---
POSTGRES_PASSWORD=
DB_PLATFORM_OWNER_PASSWORD=
DB_PLATFORM_APP_PASSWORD=
DB_PROVISIONER_PASSWORD=

# --- Kriptoqrafiya (sirlər) ---
# Master açarlar (KEK): "id:base64(32 bayt)", vergüllə bir neçə ola bilər (rotasiya üçün)
APP_CRYPTO_KEKS=
APP_CRYPTO_ACTIVE_KEK_ID=
APP_PHONE_HMAC_KEY=
APP_OTP_PEPPER=
APP_REDEMPTION_CODE_KEY=

# --- SMS və email ---
# console yalnız dev üçündür (OTP loga və dev outbox-a yazılır); prod-da postaguvercini (və ya ümumi http) / smtp
APP_SMS_PROVIDER=console
# SMS göndərən adı (operatorlarda qeydiyyatdan keçmiş alfa-ad, 11 simvola qədər) — bütün şirkətlər üçün bir
APP_SMS_SENDER=TrendStamp
# APP_SMS_PROVIDER=postaguvercini: API ünvanı (yolsuz, məs. https://api.provayder.com), PublicKey, PrivateKey
APP_SMS_PG_URL=
APP_SMS_PG_PUBLIC_KEY=
APP_SMS_PG_PRIVATE_KEY=
# APP_SMS_PROVIDER=http: ümumi JSON adapteri
APP_SMS_HTTP_URL=
APP_SMS_HTTP_API_KEY=
APP_MAIL_PROVIDER=console
# Göndərən ünvan (smtp üçün məcburi), məs. no-reply@example.az
APP_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Şirkətlərin yaradılması ---
# Prod-da standart olaraq söndürülüb: şirkət əmr sətri ilə yaradılır (README). Platforma panelindən yaratmaq üçün true.
APP_PROVISIONING_ENABLED=false
# Hər şirkətdə neçə NFC çipi pulsuzdur (qalanları pullu sayılır)
APP_NFC_FREE_TAGS=1
# Hər şirkətin bazasına ən çox bağlantı; PostgreSQL-in cəmi limiti (şirkət sayı × bu dəyər + 20-dən çox olmalıdır)
APP_TENANT_POOL_MAX=3
# Backend konteynerinin RAM limiti (deploy zamanı 2 nüsxə işləyir). 8 GB-lıq serverdə 2g qoymaq olar
BACKEND_MEM_LIMIT=1280m
POSTGRES_MAX_CONNECTIONS=300

# --- TLS (prod) ---
# Let's Encrypt hesabının emaili (sertifikat bildirişləri); certbot konteyneri üçün (docker-compose.prod.yml)
ACME_EMAIL=
# Daxili endpoint-lərin sirri (certbot backend-dən domen siyahısını alır); gen-secrets yaradır
APP_INTERNAL_TOKEN=

# --- Yalnız dev ---
APP_DEV_SIMULATOR_KEY=
DEV_SEED_ENABLED=true
# Dev test hesablarının şifrəsi (README-də göstərilir)
DEV_SEED_ADMIN_PASSWORD=Kofe-Dev-Parol-2026

# --- İlk platforma admini: yalnız --create-platform-admin əmri üçün, işlədikdən sonra silin ---
PLATFORM_ADMIN_PASSWORD=

# --- CI ---
# OWASP dependency-check üçün NVD API açarı (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

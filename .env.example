# Kafe Loyallıq — konfiqurasiya nümunəsi.
# .env faylını əl ilə doldurmayın: scripts/gen-secrets.ps1 (Windows) və ya scripts/gen-secrets.sh
# bu faylı kopyalayıb boş sirləri kriptoqrafik təsadüfi dəyərlərlə doldurur.
# .env faylı heç vaxt git-ə əlavə olunmur.

# --- Ümumi ---
SPRING_PROFILES_ACTIVE=dev
HTTPS_PORT=443
HTTP_PORT=80
APP_PLATFORM_DOMAIN=platform.localhost
# Prod-da: max-age=63072000; includeSubDomains
NGINX_HSTS_HEADER=

# --- PostgreSQL (sirlər) ---
POSTGRES_PASSWORD=
DB_PLATFORM_OWNER_PASSWORD=
DB_PLATFORM_APP_PASSWORD=
DB_PROVISIONER_PASSWORD=

# --- Kriptoqrafiya (sirlər) ---
# Master açarlar (KEK): "id:base64(32 bayt)", vergüllə bir neçə ola bilər (rotasiya üçün)
APP_CRYPTO_KEKS=
APP_CRYPTO_ACTIVE_KEK_ID=
APP_PHONE_HMAC_KEY=
APP_OTP_PEPPER=
APP_REDEMPTION_CODE_KEY=

# --- SMS və email ---
# console yalnız dev üçündür (OTP loga və dev outbox-a yazılır); prod-da http / smtp
APP_SMS_PROVIDER=console
APP_SMS_HTTP_URL=
APP_SMS_HTTP_API_KEY=
APP_MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- TLS (prod) ---
ACME_EMAIL=

# --- Yalnız dev ---
APP_DEV_SIMULATOR_KEY=
DEV_SEED_ENABLED=true

# --- CI ---
# OWASP dependency-check üçün NVD API açarı (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
